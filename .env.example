# ============================================================
# 必须修改
# ============================================================
# JWT 签名密钥，部署时在服务器执行 openssl rand -hex 32 生成随机字符串替换
APP_SECRET_KEY=change-this-to-a-random-secret
# 默认 admin 用户初始密码（首次启动时自动创建，后续可通过页面修改）
ADMIN_DEFAULT_PASSWORD=admin123

# ============================================================
# LLM 全局默认配置（用户可在页面中配置自己的 LLM，覆盖此默认值）
# ============================================================
# OpenAI 兼容 API 的地址
# LLM_BASE_URL=http://localhost:8000/v1
# API 密钥
# LLM_API_KEY=your-api-key-here
# 默认模型名称
# LLM_MODEL=default-model

# ============================================================
# 以下有合理默认值，一般无需修改
# ============================================================
# 单文件上传大小限制（MB），默认 50
# MAX_UPLOAD_SIZE_MB=50
# 跨域允许的来源，多个用逗号分隔，* 表示允许所有
# CORS_ORIGINS=*
# LLM 生成温度（0~1，越高越随机），默认 0.7
# GENERATION_TEMPERATURE=0.7
# 单次 LLM 请求最大输出 token 数，默认 4096
# GENERATION_MAX_TOKENS=4096
# 章节摘要最大长度（字符数），默认 500
# CHAPTER_SUMMARY_MAX_LENGTH=500
# 单次请求 prompt 最大字符数（防止请求体过大），默认 12000
# MAX_PROMPT_CHARS=12000