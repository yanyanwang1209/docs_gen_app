# ============================================================
# LLM 配置（每个用户可通过页面配置自己的 LLM，此处为系统默认值）
# ============================================================
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=default-model

# 可选：为不同文档类型配置不同模型
# LLM_MODEL_SRS=  # 需求规格说明书
# LLM_MODEL_HLD=  # 概要设计
# LLM_MODEL_DD=   # 详细设计
# LLM_MODEL_DBD=  # 数据库设计
# LLM_MODEL_TP=   # 测试计划
# LLM_MODEL_TS=   # 测试方案
# LLM_MODEL_TC=   # 测试用例
# LLM_MODEL_TR=   # 测试记录
# LLM_MODEL_TREP= # 测试报告

# ============================================================
# 应用配置
# ============================================================
APP_SECRET_KEY=change-this-to-a-random-secret
DATABASE_URL=sqlite+aiosqlite:///./storage/docs_gen.db
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=*

# ============================================================
# 生成配置
# ============================================================
GENERATION_TEMPERATURE=0.7
GENERATION_MAX_TOKENS=4096
CHAPTER_SUMMARY_MAX_LENGTH=500
MAX_PROMPT_CHARS=12000